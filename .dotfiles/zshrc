# Executa um arquivo específico ignorando o padrão do pom.xml
runjava2() {
    local arquivo=$1
    if [ -z "$arquivo" ]; then
        echo "❌ Uso: runjava2 NomeDoArquivo (sem o .java)"
        return 1
    fi

    # 1. Tenta descobrir o pacote automaticamente
    local caminho_arquivo=$(find src/main/java -name "$arquivo.java" | head -n 1)
    
    if [ -n "$caminho_arquivo" ]; then
        local pacote=$(grep "package " "$caminho_arquivo" | sed 's/package //;s/;//')
        echo "🚀 Rodando $pacote.$arquivo..."
        # 2. Executa via Maven apontando a classe manualmente
        mvn compile exec:java -Dexec.mainClass="$pacote.$arquivo"
    else
        echo "❌ Erro: Arquivo $arquivo.java não encontrado nas pastas de fonte!"
    fi
}

novo-projeto() {
    local nome_projeto=$1
    if [ -z "$nome_projeto" ]; then
        echo "❌ Uso: novo-projeto NomeDoExercicio"
        return 1
    fi

    # Pergunta o nome do pacote ao usuário
    echo -n "📦 Digite o nome do pacote (ex: iap.lab2): "
    read pacote
    
    # Se o usuário não digitar nada, usa um padrão
    [ -z "$pacote" ] && pacote="br.com.faculdade.ads"
    
    # Converte pontos em barras para criar as pastas
    local caminho_pacote=$(echo $pacote | tr '.' '/')

    # Cria a estrutura completa
    mkdir -p "$nome_projeto/src/main/java/$caminho_pacote"
    
    # Gera o pom.xml refinado para o NetBeans
    cat <<EOF > "$nome_projeto/pom.xml"
<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>$pacote</groupId>
    <artifactId>$nome_projeto</artifactId>
    <version>1.0-SNAPSHOT</version>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <exec.mainClass>$pacote.$nome_projeto</exec.mainClass>
    </properties>
</project>
EOF

    # Gera o arquivo Java com o nome do projeto
    cat <<EOF > "$nome_projeto/src/main/java/$caminho_pacote/$nome_projeto.java"
package $pacote;

public class $nome_projeto {
    public static void main(String[] args) {
        System.out.println("🚀 Projeto $nome_projeto iniciado no pacote $pacote!");
    }
}
EOF

    echo "✅ Estrutura de '$nome_projeto' criada com sucesso!"
    cd "$nome_projeto"
    echo "📂 Você está em: \$(pwd)"
}

alias backup="mvn clean && git add . && git commit -m 'Update' && git push"

check() {
    echo "🔍 Iniciando check-up do projeto ADS..."
    
    # 1. Verifica se existe o pom.xml
    if [ ! -f "pom.xml" ]; then
        echo "❌ Erro: pom.xml não encontrado! Você está na pasta do projeto?"
        return 1
    fi
    echo "✅ pom.xml localizado."

    # 2. Verifica a versão do Java para o NetBeans
    if grep -q "<maven.compiler.release>25</maven.compiler.release>" pom.xml; then
        echo "✅ pom.xml configurado para Java 25 (Padrão NetBeans)."
    else
        echo "⚠️  Aviso: pom.xml não está usando o release 25."
    fi

    # 3. Verifica a estrutura de pastas vs pacote
    local main_file=$(find src/main/java -name "*.java" | head -n 1)
    if [ -n "$main_file" ]; then
        echo "✅ Arquivo fonte localizado: $main_file"
        local package_declared=$(grep "package " "$main_file" | sed 's/package //;s/;//')
        echo "📦 Pacote declarado no código: $package_declared"
    else
        echo "❌ Erro: Nenhum arquivo .java encontrado em src/main/java!"
    fi
    
    echo "🚀 Check-up finalizado! Se não houver erros fatais, pode rodar 'exportar'."
}
